# Demucs model/device. CPU works everywhere but is slower.
KARAOKE_DEMUCS_MODEL=htdemucs
KARAOKE_DEMUCS_DEVICE=cpu

# If Demucs cannot import/run/download its model, keep karaoke usable by
# converting with FFmpeg and applying stereo phase cancellation instead of HTTP 500.
KARAOKE_ALLOW_PHASE_FALLBACK=true

# Upload limit in MB.
KARAOKE_MAX_UPLOAD_MB=200

# Comma-separated frontend origins allowed by CORS.
KARAOKE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
